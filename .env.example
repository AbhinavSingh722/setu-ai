# SETU — Environment Variables
# Copy this file to .env and fill in values as needed.
# The core demo runs with ZERO paid API keys (Granite via Ollama).

# ---- Ollama (required, defaults work for local install) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# ---- Optional: IBM watsonx.ai (cloud enhancement, not required) ----
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
